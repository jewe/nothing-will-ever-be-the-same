#include <CmdMessenger.h>
#include <NWEBTS.h>

/*

  NOTHING WILL EVER BE THE SAME
  Mini / Box

  Arduino Pro or Pro Mini
  328P 5V 16MHz

  2018-2026 Jens Weber

  v0.18
  - step pulses generated by Timer1 hardware (pin 9 = OC1A), fed from a queue:
    no jitter, no gaps between segments, serial stays responsive while driving
  - smooth profile (smoothstep of the step period) -> no acceleration jumps at segment joins
  - blend from the actual speed when two segments don't match (e.g. DOWN_4 199 -> DOWN_5 150)
  - velocities <= 3 work (Exp09: delayMicroseconds overflow -> sawtooth speed)
  - limit switch: confirmed after 2 ms, safety stop in every UP segment, early hit -> kError
  - gentle start after the driver was disabled (DOWN_5 = FREE)
  - per phase timing report, position at limit switch (step loss indicator)

  BENCH 1: no driver / motor / switch needed. The limit switch is simulated
  (position back at 0), the onboard LED toggles with every step.
*/

////////////////////////////////////////////////////////////////////////////////
// CONFIG

#ifndef BENCH
#define BENCH 0
#endif
// BENCH only: simulate an early limit switch hit in this state (e.g. UP_2), 0 = off
#ifndef SIM_EARLY_LIMIT_STATE
#define SIM_EARLY_LIMIT_STATE 0
#endif

String version = "0.18";

// Exp09 added ~190us per half step (160us pulse + loop overhead) to the nominal
// period. Keeping it makes the configured velocities look like they did in Trier.
#define TRIER_COMP_US     190
#define MIN_PERIOD_US     150    // safety clamp (fastest half step)
#define ENABLE_SETTLE_MS  80     // after enabling the driver, before the first step
#define LIMIT_CONFIRM_US  2000   // limit switch must still be LOW after this time
#define BLEND_MAX_STEPS   40     // half steps to blend a speed mismatch between segments
#define MAX_REPEATS_INIT  80     // INIT_2 chunks without limit switch -> STOPPED
#define MAX_REPEATS_UP5   40     // UP_5 chunks without limit switch -> STOPPED
#define HEARTBEAT_INIT_MS 500    // status while waiting in INIT_0
#define HEARTBEAT_MS      30000  // status while idle

bool verbose = BENCH; // log more details (set by master: config state 0)

// PINS
#define LIMIT_PIN 2 // interrupt pin for limit switch
#define EN_PIN 7    // enable (LOW active)
#define DIR_PIN 8   // direction (HIGH = up)
#define STEP_PIN 9  // step = OC1A, driven by Timer1 only (never use digitalWrite on it!)
#define CFG1_PIN 5  // microsteps / chopping
#define CFG2_PIN 6  // microsteps / chopping
#define LED 13

#define UP true
#define DOWN false
#define FREE true
#define HOLD false

StateParams stateParams[NWEBTS_NUM_STATES];
CmdMessenger cmdMessenger = CmdMessenger(Serial);

uint8_t state = STOPPED, lastState = STOPPED;
unsigned long stateSince, lastStateDuration, heartbeat;
uint8_t repeats;              // INIT_2 / UP_5 chunks
bool homed = false;           // limit switch seen once
int32_t calStartPos;

////////////////////////////////////////////////////////////////////////////////
// STEP ENGINE (Timer1, CTC, 0.5us ticks)
//
// Every queue entry is one interval. The ISR runs at the end of an interval
// (compare match) and loads the next one. If the entry has F_PULSE, the hardware
// sets STEP high exactly at the end of that interval; the ISR clears it again.

#define QSIZE 32 // power of 2
#define F_PULSE 1
#define F_MARK  2 // first entry of a segment (timing report)

struct StepEntry { uint16_t ticks; uint8_t flags; };
volatile StepEntry q[QSIZE];
volatile uint8_t qHead = 0, qTail = 0; // head written by loop, tail by ISR
volatile uint8_t curFlags = 0;
volatile bool motionRunning = false;
volatile bool streamOpen = false;      // false: stop when the queue is empty
volatile int32_t posHalf = 0;          // half steps, + = down, 0 = limit switch
volatile int8_t dirSign = 1;
volatile uint32_t stepsDone = 0;
volatile uint16_t underruns = 0;
volatile uint16_t maxLatTicks = 0;
volatile unsigned long stopMicros = 0;
#define MARKS 16
volatile unsigned long markMicros[MARKS];
volatile uint8_t markCount = 0;

bool driverEnabled = false;
bool dirUp = false;
float lastPeriod = 0;   // last queued period (us), 0 = from standstill

ISR(TIMER1_COMPA_vect) {
  uint16_t lat = TCNT1;
  if (lat > maxLatTicks) maxLatTicks = lat;

  // end the pulse the hardware just started (if any): force pin LOW
  TCCR1A = _BV(COM1A1);
  TCCR1C = _BV(FOC1A);
  if (curFlags & F_PULSE) {
    stepsDone++;
    posHalf += dirSign;
#if BENCH
    PINB = _BV(5); // toggle LED (pin 13)
#endif
  }

  if (qTail != qHead) {
    uint8_t t = qTail;
    uint8_t f = q[t].flags;
    OCR1A = q[t].ticks - 1;
    qTail = (t + 1) & (QSIZE - 1);
    TCCR1A = (f & F_PULSE) ? (_BV(COM1A1) | _BV(COM1A0)) : 0; // set on match / pin = PORT (LOW)
    if (f & F_MARK) markMicros[markCount++ & (MARKS - 1)] = micros();
    curFlags = f;
  } else if (streamOpen) {
    // loop() was too slow: wait 100us without a pulse
    OCR1A = 200 - 1;
    TCCR1A = 0;
    curFlags = 0;
    underruns++;
  } else {
    // done
    TCCR1B = _BV(WGM12); // stop clock
    TCCR1A = 0;
    TIMSK1 = 0;
    curFlags = 0;
    motionRunning = false;
    stopMicros = micros();
  }
}

void motionInit() {
  PORTB &= ~_BV(1);  // STEP low
  DDRB |= _BV(1);    // STEP output
  TIMSK1 = 0;
  TCCR1A = 0;
  TCCR1B = _BV(WGM12); // CTC, stopped
}

void motionStart() {
  noInterrupts();
  TCCR1A = 0;
  TCNT1 = 0;
  OCR1A = 200 - 1; // first interval 100us, no pulse
  curFlags = 0;
  streamOpen = true;
  motionRunning = true;
  TIFR1 = _BV(OCF1A);
  TIMSK1 = _BV(OCIE1A);
  TCCR1B = _BV(WGM12) | _BV(CS11); // prescaler 8 -> 0.5us
  interrupts();
}

// stop as soon as possible, drop queued steps
void motionAbort() {
  noInterrupts();
  qHead = qTail;
  streamOpen = false;
  interrupts();
  while (motionRunning) ;
  lastPeriod = 0;
}

// let the queued steps run out
void motionDrain() {
  streamOpen = false;
  while (motionRunning) ;
  lastPeriod = 0;
}

int32_t getPos() {
  noInterrupts();
  int32_t p = posHalf;
  interrupts();
  return p;
}

void setPos(int32_t p) {
  noInterrupts();
  posHalf = p;
  interrupts();
}

////////////////////////////////////////////////////////////////////////////////
// LIMIT SWITCH

volatile bool limitPending = false;
volatile unsigned long limitPendingAt;
uint16_t ignoredLimits = 0;
uint16_t limitHits = 0;
uint16_t segPushed;   // half steps queued in the current segment

unsigned long limitPendingAge() {
  noInterrupts();
  unsigned long at = limitPendingAt;
  interrupts();
  return micros() - at;
}

void limitSwitchISR() {
  if (!limitPending) {
    limitPending = true;
    limitPendingAt = micros();
  }
}

// true = limit switch confirmed
bool checkLimit() {
#if BENCH
  if (getPos() <= 0) return true;  // simulated switch at position 0 (power-up position)
  #if SIM_EARLY_LIMIT_STATE
  static uint8_t simDone = 0;
  if (state == DOWN_1) simDone = 0;
  if (state == SIM_EARLY_LIMIT_STATE && !simDone && segPushed > 200) { simDone = 1; return true; }
  #endif
#endif
  if (!limitPending && digitalRead(LIMIT_PIN) == LOW) { // already pressed / missed edge
    noInterrupts();
    limitPending = true;
    limitPendingAt = micros();
    interrupts();
  }
  if (!limitPending) return false;
  if (limitPendingAge() < LIMIT_CONFIRM_US) return false;
  limitPending = false;
  if (digitalRead(LIMIT_PIN) == LOW) {
    limitHits++;
    return true;
  }
  ignoredLimits++;
  return false;
}

////////////////////////////////////////////////////////////////////////////////
// DRIVE

enum { ABORT_NONE, ABORT_LIMIT, ABORT_STATE };
uint8_t abortReason;
uint8_t motionState;  // state the current segment belongs to
bool motionUp;

// phase report
#define SEGS 16
struct SegInfo { uint8_t state; uint8_t mark; uint16_t n; uint32_t planUs; uint16_t pFirst, pLast; bool aborted; };
SegInfo segs[SEGS];
uint8_t segCount;
uint8_t markPushed;
unsigned long phaseStart;

void resetPhaseStats() {
  noInterrupts();
  underruns = 0;
  maxLatTicks = 0;
  markCount = 0;
  interrupts();
  markPushed = 0;
  segCount = 0;
  phaseStart = millis();
}

// keep serial alive, watch limit switch and state changes while driving
void poll() {
  cmdMessenger.feedinSerialData(); // may change state (STOP, INIT ...)
  if (abortReason) return;
  if (state != motionState) abortReason = ABORT_STATE;
  else if (motionUp && checkLimit()) abortReason = ABORT_LIMIT;
}

bool qPush(uint16_t ticks, uint8_t flags) {
  uint8_t next = (qHead + 1) & (QSIZE - 1);
  while (next == qTail) { // full
    poll();
    if (abortReason) return false;
  }
  q[qHead].ticks = ticks;
  q[qHead].flags = flags;
  qHead = next;
  if (!motionRunning) motionStart();
  return true;
}

bool pushPeriod(float us, bool mark) {
  if (us < MIN_PERIOD_US) us = MIN_PERIOD_US;
  uint32_t t = (uint32_t)(us * 2.0 + 0.5);
  uint8_t m = mark ? F_MARK : 0;
  while (t > 60000) { // > 30ms: wait without pulse first
    if (!qPush(60000, m)) return false;
    m = 0;
    t -= 60000;
  }
  return qPush(t, F_PULSE | m);
}

float periodUs(uint16_t v) {
  if (v < 1) v = 1;
  return 50000.0 / v + TRIER_COMP_US;
}

// Drive the segment of the current state.
// constant: drive at vel2 only (repeated chunks of INIT_2 / UP_5)
// Returns true when all steps are queued, false when aborted (see abortReason).
bool drive(bool up, bool free, bool constant = false) {
  abortReason = ABORT_NONE;
  motionState = state;
  motionUp = up;
  segPushed = 0;
  StateParams p = stateParams[state];
  if (p.steps == 0) return true;

  if (up != dirUp || !driverEnabled) {
    motionDrain();
    digitalWrite(DIR_PIN, up ? HIGH : LOW);
    noInterrupts();
    dirSign = up ? -1 : 1;
    interrupts();
    dirUp = up;
    delayMicroseconds(50);
    if (!driverEnabled) {
      digitalWrite(EN_PIN, LOW); // enable driver, let the coil current settle
      driverEnabled = true;
      delay(ENABLE_SETTLE_MS);
    }
  }

  uint16_t n = p.steps * 2; // half steps
  float p1 = periodUs(constant ? p.vel2 : p.vel1);
  float p2 = periodUs(p.vel2);
  float pin = (motionRunning && lastPeriod > 0) ? lastPeriod : p1;
  uint16_t b = 0;
  if (fabs(pin - p1) > 0.02 * p1) b = min((uint16_t)BLEND_MAX_STEPS, (uint16_t)(n / 4));
  float invB = b ? 1.0 / b : 0;
  float invN = 1.0 / (n - b);

  SegInfo *si = segCount < SEGS ? &segs[segCount++] : NULL;
  if (si) {
    si->state = state;
    si->mark = markPushed;
    si->n = n;
    si->planUs = 0;
    si->aborted = false;
  }
  markPushed++;

  for (uint16_t i = 0; i < n; i++) {
    float a, c, u;
    if (i < b) { u = (i + 1) * invB; a = pin; c = p1; }
    else       { u = (i - b + 1) * invN; a = p1; c = p2; }
    float per = a + (c - a) * u * u * (3.0 - 2.0 * u); // smoothstep: zero acceleration at both ends
    if (!pushPeriod(per, i == 0)) break;
    segPushed++;
    lastPeriod = per;
    if (si) {
      si->planUs += (uint32_t)per;
      if (i == 0) si->pFirst = per;
      si->pLast = per;
    }
    poll();
    if (abortReason) break;
  }

  if (abortReason) {
    motionAbort();
    if (si) si->aborted = true;
    return false;
  }
  if (free) {
    motionDrain();
    digitalWrite(EN_PIN, HIGH); // driver off: the thread can flow
    driverEnabled = false;
  }
  return true;
}

void stopMotor() {
  motionAbort();
  digitalWrite(EN_PIN, HIGH);
  driverEnabled = false;
}

////////////////////////////////////////////////////////////////////////////////
// COMMANDS

void attachCommandCallbacks() {
  cmdMessenger.attach(OnUnknownCommand);
  cmdMessenger.attach(kReset, reset);
  cmdMessenger.attach(kState, receiveState);
  cmdMessenger.attach(kGetStatus, sendStatus);
  cmdMessenger.attach(kConfigure, configureState);
}

void OnUnknownCommand() {
  cmdMessenger.sendCmd(kError, F("Command without attached callback"));
}

void(* resetFunc) (void) = 0; // software reset

void reset() {
  stopMotor();
  sendLog("RESET Version " + version);
  delay(500);
  resetFunc();
}

void sendStatus() {
  cmdMessenger.sendCmdStart(kStatus);
  cmdMessenger.sendCmdArg(state);
  cmdMessenger.sendCmdArg(lastState);
  float t = lastStateDuration / 1000.0;
  cmdMessenger.sendCmdArg(t);
  t = (millis() - stateSince) / 1000.0;
  cmdMessenger.sendCmdArg(t);
  cmdMessenger.sendCmdEnd();
  heartbeat = millis();
}

// receive state params from master
void configureState() {
  uint8_t _state = cmdMessenger.readInt16Arg();
  uint8_t mode = cmdMessenger.readInt16Arg();
  uint16_t steps = cmdMessenger.readInt16Arg();
  uint16_t vel1 = cmdMessenger.readInt16Arg();
  uint16_t vel2 = cmdMessenger.readInt16Arg();

  if (_state > 0 && _state < NWEBTS_NUM_STATES) {
    stateParams[_state].mode = mode; // ignored: always half steps
    stateParams[_state].steps = min(steps, (uint16_t)16000);
    stateParams[_state].vel1 = vel1 == 0 ? 1 : vel1;
    stateParams[_state].vel2 = vel2 == 0 ? 1 : vel2;
    cmdMessenger.sendCmd(kAck);
  } else if (_state == 0) {
    // state 0: global options
    verbose = BENCH || mode == 1;
    cmdMessenger.sendCmd(kAck);
  } else {
    sendError(String(F("Unknown config state ")) + _state);
  }
}

void receiveState() {
  uint8_t _state = cmdMessenger.readInt16Arg();
  cmdMessenger.sendCmd(kAck);
  if (_state < NWEBTS_NUM_STATES) setState(_state);
  else sendError(String(F("Unknown state ")) + _state);
}

void setState(uint8_t _state) {
  if (state != _state) {
    lastState = state;
    lastStateDuration = millis() - stateSince;
    state = _state;
    stateSince = millis();

    switch (state) {
      case INIT_1:
        homed = false;
        resetPhaseStats();
        break;
      case INIT_2:
      case UP_5:
        repeats = 0;
        break;
      case DOWN_1:
      case UP_1:
        resetPhaseStats();
        break;
      case CAL_1:
        calStartPos = getPos();
        sendLog(F("Calibration started"));
        break;
    }
  }
  sendStatus();
}

void sendLog(String msg) {
  cmdMessenger.sendCmd(kLog, msg);
}

void sendError(String msg) {
  cmdMessenger.sendCmd(kError, msg);
}

// timing report of the last phase (motion has stopped)
void reportPhase(const char *name) {
  noInterrupts();
  uint16_t und = underruns;
  uint16_t lat = maxLatTicks;
  uint8_t mc = markCount;
  unsigned long stopT = stopMicros;
  interrupts();

  if (verbose && segCount <= SEGS && mc <= MARKS) {
    for (uint8_t k = 0; k < segCount; k++) {
      SegInfo &s = segs[k];
      unsigned long start = markMicros[s.mark & (MARKS - 1)];
      unsigned long end = (k + 1 < segCount) ? markMicros[segs[k + 1].mark & (MARKS - 1)] : stopT;
      sendLog(String(state2Name(s.state)) + (s.aborted ? F(" ABORT") : F("")) +
              F(" n=") + s.n +
              F(" plan=") + (s.planUs / 1000) +
              F("ms real=") + ((end - start) / 1000) +
              F("ms v=") + (uint16_t)(1e6 / s.pFirst) + F("->") + (uint16_t)(1e6 / s.pLast) + F("hs/s"));
    }
  }
  String sum = String(name) + F(" t=") + (millis() - phaseStart) +
               F("ms und=") + und + F(" lat=") + (lat / 2) + F("us ign=") + ignoredLimits;
  if (und > 0) sendError(sum);
  else sendLog(sum);
}

// limit switch confirmed: position check (step loss) and new zero
void onLimit() {
  int32_t p = getPos();
  if (homed && (verbose || p > 20 || p < -20)) {
    sendLog(String(F("limit at pos ")) + (p / 2) + F(" (full steps, 0 = no loss)"));
  }
  setPos(0);
  homed = true;
  limitPending = false;
}

////////////////////////////////////////////////////////////////////////////////
// SETUP / LOOP

void setup() {
  digitalWrite(EN_PIN, HIGH); // driver off
  pinMode(EN_PIN, OUTPUT);
  pinMode(DIR_PIN, OUTPUT);
  digitalWrite(DIR_PIN, LOW);
  motionInit();
  halfSteps();
  pinMode(LED, OUTPUT);
  digitalWrite(LED, LOW);
  pinMode(LIMIT_PIN, INPUT_PULLUP);

  while (!Serial) ;
  delay(3000); // wait for master on TX0/RX0

  nwebtsLoadDefaults(stateParams); // master config overrides
  stateParams[CAL_1].steps = 25;   // calibration: slow fall in chunks
  stateParams[CAL_1].vel1 = 5;
  stateParams[CAL_1].vel2 = 5;

  attachInterrupt(digitalPinToInterrupt(LIMIT_PIN), limitSwitchISR, FALLING);

  Serial.begin(38400);
  cmdMessenger.printLfCr();
  attachCommandCallbacks();

  sendLog("Setup finished. Version " + version + (BENCH ? F(" BENCH") : F("")));
  setState(INIT_0);
}

void loop() {
  cmdMessenger.feedinSerialData();

  // limit switch events while not lifting are not relevant
  if (!motionRunning && limitPending && state != INIT_2 && state != UP_5) {
    if (limitPendingAge() > LIMIT_CONFIRM_US) limitPending = false;
  }

  // heartbeat
  unsigned long hb = state == INIT_0 ? HEARTBEAT_INIT_MS : HEARTBEAT_MS;
  if (millis() - heartbeat > hb) sendStatus();

  switch (state) {

    case STOPPED:
      if (motionRunning || driverEnabled) stopMotor();
      break;

    // INIT ////////////////
    case INIT_0:
      // wait for master
      break;

    case INIT_1:
      if (drive(DOWN, HOLD)) setState(INIT_2);
      break;

    case INIT_2:
      if (drive(UP, HOLD, repeats > 0)) {
        if (++repeats > MAX_REPEATS_INIT) {
          stopMotor();
          sendError(F("INIT_2: no limit switch"));
          setState(STOPPED);
        }
      } else if (abortReason == ABORT_LIMIT) {
        onLimit();
        setState(RELAX);
      }
      break;

    // DOWN ////////////////
    case DOWN_1:
      if (drive(DOWN, HOLD)) setState(DOWN_2);
      break;

    case DOWN_2:
      if (drive(DOWN, HOLD)) setState(DOWN_3);
      break;

    case DOWN_3:
      if (drive(DOWN, HOLD)) setState(DOWN_4);
      break;

    case DOWN_4:
      if (drive(DOWN, HOLD)) setState(DOWN_5);
      break;

    case DOWN_5:
      if (drive(DOWN, FREE)) {
        motionDrain();
        reportPhase("DOWN");
        setState(DOWN_READY);
      }
      break;

    case DOWN_READY:
      // wait for master
      break;

    // UP ////////////////
    case UP_1:
    case UP_2:
    case UP_3:
      if (drive(UP, HOLD)) setState(state + 1);
      else if (abortReason == ABORT_LIMIT) {
        // safety stop: thread may be tangled
        sendError(String(F("limit early in ")) + state2Name(state));
        onLimit();
        setState(RELAX);
      }
      break;

    case UP_4:
      if (drive(UP, HOLD)) setState(UP_5);
      else if (abortReason == ABORT_LIMIT) {
        onLimit();
        setState(RELAX);
      }
      break;

    case UP_5:
      if (drive(UP, HOLD, repeats > 0)) {
        if (++repeats > MAX_REPEATS_UP5) {
          stopMotor();
          sendError(F("UP_5: no limit switch"));
          setState(STOPPED);
        }
      } else if (abortReason == ABORT_LIMIT) {
        onLimit();
        setState(RELAX);
      }
      break;

    case RELAX:
      if (drive(DOWN, HOLD)) {
        motionDrain();
        reportPhase(lastState == INIT_2 ? "INIT" : "UP");
        setState(UP_READY);
      }
      break;

    case UP_READY:
      // wait for master
      break;

    // CALIBRATION ////////////////
    case CAL_1:
      drive(DOWN, HOLD); // repeated until master sends CAL_2
      break;

    case CAL_2:
      motionDrain();
      sendLog(String(F("calibration full steps: ")) + ((getPos() - calStartPos) / 2));
      setState(CAL_3);
      break;

    case CAL_3:
      // wait for master
      break;
  }
}

/////////////////////////////////////////////////////////
// microstep configuration (TMC2100 standalone)
// since v0.18 always half steps (1/2 interpolated, spreadCycle)

void halfSteps() {
  pinMode(CFG1_PIN, INPUT);  // open
  digitalWrite(CFG1_PIN, LOW);
  pinMode(CFG2_PIN, OUTPUT); // GND
  digitalWrite(CFG2_PIN, LOW);
}
